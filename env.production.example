# DunckOps Platform Production Environment
# Copy this file to .env and replace placeholder values before running Docker Compose.

# Runtime
ASPNETCORE_ENVIRONMENT=Production
API_PORT=9100
WEB_PORT=9000

# Local DunckOps metadata database (generated by install.sh)
DUNCKOPS_DB_NAME=pitr
DUNCKOPS_DB_USER=pitr
DUNCKOPS_DB_PASSWORD=pitr-local

# Local MinIO storage (generated by install.sh)
LOCAL_MINIO_API_PORT=9002
LOCAL_MINIO_CONSOLE_PORT=9001
LOCAL_MINIO_BUCKET=pitr-local
LOCAL_MINIO_ACCESS_KEY=replace-with-generated-access-key
LOCAL_MINIO_SECRET_KEY=replace-with-generated-secret-key

# Auth (generated by install.sh, 32+ characters each)
Jwt__Key=replace-with-at-least-32-characters
Encryption__MasterKey=replace-with-at-least-32-characters

# Docker Agent (generated by install.sh, 32+ characters)
DOCKER_AGENT_KEY=replace-with-at-least-32-characters
DOCKER_ALLOW_ANY_CONTAINER=false
# Host/IP externo do Docker Agent (usado para gerar as strings de conexão exibidas na Web UI)
# Se não configurado, assume o host de DOCKER_AGENT_URL (que em produção é o DNS interno 'docker-agent')
# DOCKER_AGENT_EXTERNAL_HOST=

# Commercial API (SSO login validation & license phone-home)
VITE_COMMERCIAL_API_URL=/commercial-api
VITE_COMMERCIAL_PORTAL_URL=https://dunckops.com/dashboard
CommercialAuth__ApiUrl=https://api.dunckops.com/api/v1
CommercialAuth__PublicKeyUrl=https://api.dunckops.com/license-public.pem

# Friendly name shown when this VPS appears in the commercial license selector.
INSTALLATION_NAME=

# Stable installation identity, generated once by installers. Never use the setup token here.
# Preserve this value and .env during reinstall, updates and recovery (1-200 characters).
INSTALLATION_FINGERPRINT=

# Offline Enterprise bootstrap only: random secret, at least 32 characters.
# install-offline.sh generates it; online installation leaves bootstrap disabled by default.
# Keep .env private (chmod 600). Aliases: Setup__Token and Installation__Fingerprint.
DUNCKOPS_SETUP_TOKEN=

# Optional license key. If empty, login configures a free license automatically.
DUNCKOPS_LICENSE_KEY=

# Commercial RSA public key supplied to API and Worker; required for offline license validation.
# The API also refreshes the current public key automatically from CommercialAuth__PublicKeyUrl.
# For PEM values in .env, use escaped newlines (\n) instead of raw line breaks.
LICENSE_PUBLIC_KEY=

# Docker image channel. Pinning a version (for example, 1.0.0) disables automatic version advances.
DUNCKOPS_VERSION=latest
REGISTRY_OWNER=dunck01
# Imagens PostgreSQL com WAL-G/PITR, publicadas por major (ex.: :18-alpine).
# POSTGRES_IMAGE_PREFIX=ghcr.io/dunck01/dunckops-postgres

# CORS
CORS_ORIGINS=http://localhost:9000

# Docker Ops (optional - only needed for backup/restore operations)
# DOCKER_OPERATIONS_ENABLED=true
# The production Docker Agent is only reachable inside the Compose network.
