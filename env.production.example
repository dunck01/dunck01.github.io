# DunckOps Platform Production Environment
# Copy this file to .env and replace placeholder values before running Docker Compose.

# Runtime
# Installers keep explicit ports; fresh implicit defaults use free alternatives from 9003.
# Bindings: PORT, IPv4:PORT or [IPv6]:PORT; Compose parses quotes/inline comments.
# Port checks require ss (iproute2) or netstat (net-tools), plus access to Docker Engine.
# Local Web/API readiness requires curl; remote credential access requires HTTPS or SSH tunnel.
# Installers derive LOCAL_MINIO_EXTERNAL_ENDPOINT from MinIO binding unless explicitly configured.
# DUNCKOPS_INSTALL_MINIO_ENDPOINT tracks generated value so later binding changes follow it.
# LOCAL_MINIO_EXTERNAL_ENDPOINT=http://localhost:9002
# Installers manage DUNCKOPS_INSTALL_PORTS_PENDING until first port preflight succeeds.
ASPNETCORE_ENVIRONMENT=Production
API_PORT=9100
WEB_PORT=9000

# Local DunckOps metadata database (generated by install.sh)
DUNCKOPS_DB_NAME=pitr
DUNCKOPS_DB_USER=pitr
DUNCKOPS_DB_PASSWORD=pitr-local

# Local MinIO storage (generated by install.sh)
LOCAL_MINIO_API_PORT=9002
LOCAL_MINIO_CONSOLE_PORT=9001
LOCAL_MINIO_BUCKET=pitr-local
LOCAL_MINIO_ACCESS_KEY=replace-with-generated-access-key
LOCAL_MINIO_SECRET_KEY=replace-with-generated-secret-key

# Auth (generated by install.sh, 32+ characters each)
Jwt__Key=replace-with-at-least-32-characters
Encryption__MasterKey=replace-with-at-least-32-characters

# Docker Agent (generated by install.sh, 32+ characters)
DOCKER_AGENT_KEY=replace-with-at-least-32-characters
DOCKER_ALLOW_ANY_CONTAINER=false

# Experimental manual LOCAL full-instance snapshots, disabled by default; not yet released.
# Requires BOTH API/agent enabled and both runtime images installed. See docs/physical-snapshots.md.
# Install/update pulls these multi-GB tools ONLY when explicitly enabled.
PHYSICAL_SNAPSHOTS_ENABLED=false
# Integer 1..120; the same timeout is passed to API and agent.
PHYSICAL_SNAPSHOT_TIMEOUT_MINUTES=60
# Empty uses ghcr.io/${REGISTRY_OWNER}/dunckops-<engine>-snapshot-runtime:${DUNCKOPS_VERSION}.
# Enable only after these images exist for the selected release, or override with locally built images.
MYSQL_SNAPSHOT_RUNTIME_IMAGE=
MARIADB_SNAPSHOT_RUNTIME_IMAGE=

# Experimental manual operations, not a production-readiness claim. See docs/*-operations.md.
# Disabled: no new operation tools downloaded. Enabled: MySQL/MariaDB/Mongo tools only.
MULTI_ENGINE_OPERATIONS_ENABLED=false
# Empty uses versioned GHCR image matching DUNCKOPS_VERSION. Agent only.
# Installer pulls artifact helper only when MULTI_ENGINE_OPERATIONS_ENABLED=true.
ENGINE_ARTIFACTS_RUNTIME_IMAGE=
# Empty prefix resolves ghcr.io/${REGISTRY_OWNER}/dunckops-engine-copy-runtime (no tag).
# Empty version resolves DUNCKOPS_VERSION; published tags are <engine>-<family>-<release>.
ENGINE_COPY_RUNTIME_IMAGE_PREFIX=
ENGINE_COPY_RUNTIME_VERSION=
ENGINE_PROVISIONING_BIND_ADDRESS=127.0.0.1
# Set false for a remote Agent or an API/Worker on a different Docker daemon/network.
# Bundled Compose explicitly shares the Docker network; this is not autodetection.
# Remote/separate Agent: set false and configure reachable bind/external host.
ENGINE_PROVISIONING_API_SHARED_NETWORK=true
# Online target-image pull policy; offline installer forces false (requires Agent enforcement).
ENGINE_PROVISIONING_ALLOW_IMAGE_PULL=true
ENGINE_PROVISIONING_NETWORK=
SQLSERVER_PROVISIONING_ENCRYPT=true
# Explicit isolated lab override only; not a production TLS trust solution.
SQLSERVER_PROVISIONING_TRUST_SERVER_CERTIFICATE=false
# Confirm licensing outside application and explicitly choose licensed PID before enabling SQL creation.
SQLSERVER_PROVISIONING_LICENSE_CONFIRMED=false
SQLSERVER_PROVISIONING_PID=
# Empty uses published ghcr.io/${REGISTRY_OWNER}/dunckops-<engine>-operations-runtime:${DUNCKOPS_VERSION}.
# Explicit helper overrides must already be installed locally before install/update.
MYSQL_OPERATIONS_RUNTIME_IMAGE=
MARIADB_OPERATIONS_RUNTIME_IMAGE=
MONGO_OPERATIONS_RUNTIME_IMAGE=
MYSQL_RESTORE_SERVER_IMAGE=mysql:8.4.11
MARIADB_RESTORE_SERVER_IMAGE=mariadb:11.4.13
# With MULTI enabled, pulls pinned restore plus Core MySQL/MariaDB/Mongo family images; never starts servers.
MULTI_ENGINE_RESTORE_SERVER_IMAGES_PULL=false
# Unverified SQL lab execution only; SQL remains productionReady=false.
SQLSERVER_OPERATIONS_UNVERIFIED_OPT_IN=false
# Empty downloads published SQL client tools ONLY with both opt-ins; no SQL Server/EULA.
SQLSERVER_OPERATIONS_CLIENT_TOOLS_IMAGE=
# After download, manually inspect/approve client image; ONLY sha256:<64 hex>, NEVER registry tag.
SQLSERVER_OPERATIONS_RUNTIME_IMAGE=
# Manually provision existing distinct local volumes and signing key outside this repository.
SQLSERVER_OPERATIONS_BACKUP_VOLUME=
SQLSERVER_OPERATIONS_SIGNING_VOLUME=
SQLSERVER_OPERATIONS_SIGNING_PUBLIC_KEY_SHA256=
# Integer 60..7200, equal on API and agent.
SQLSERVER_OPERATIONS_TIMEOUT_SECONDS=1800
DUNCKOPS_LOCAL_BACKUP_VOLUME=dunckops-local-backups
# Host/IP externo do Docker Agent (usado para gerar as strings de conexão exibidas na Web UI)
# Se não configurado, assume o host de DOCKER_AGENT_URL (que em produção é o DNS interno 'docker-agent')
# DOCKER_AGENT_EXTERNAL_HOST=

# Commercial API (SSO login validation & license phone-home)
VITE_COMMERCIAL_API_URL=/commercial-api
VITE_COMMERCIAL_PORTAL_URL=https://dunckops.com/dashboard
CommercialAuth__ApiUrl=https://api.dunckops.com/api/v1
CommercialAuth__PublicKeyUrl=https://api.dunckops.com/license-public.pem

# Friendly name shown when this VPS appears in the commercial license selector.
INSTALLATION_NAME=

# Stable installation identity, generated once by installers. Never use the setup token here.
# Preserve this value and .env during reinstall, updates and recovery (1-200 characters).
INSTALLATION_FINGERPRINT=

# Offline Enterprise bootstrap only: random secret, at least 32 characters.
# install-offline.sh generates it; online installation leaves bootstrap disabled by default.
# Keep .env private (chmod 600). Aliases: Setup__Token and Installation__Fingerprint.
DUNCKOPS_SETUP_TOKEN=

# Optional license key. If empty, login configures a free license automatically.
DUNCKOPS_LICENSE_KEY=

# Commercial RSA public key supplied to API and Worker; required for offline license validation.
# The API also refreshes the current public key automatically from CommercialAuth__PublicKeyUrl.
# For PEM values in .env, use escaped newlines (\n) instead of raw line breaks.
LICENSE_PUBLIC_KEY=

# Docker image channel. Pinning a version (for example, 1.0.0) disables automatic version advances.
# Required: set an actual published X.Y.Z release before install/update. Never latest.
DUNCKOPS_VERSION=
REGISTRY_OWNER=dunck01
# Imagens PostgreSQL com WAL-G/PITR, publicadas por major (ex.: :18-alpine).
# POSTGRES_IMAGE_PREFIX=ghcr.io/dunck01/dunckops-postgres

# CORS: fresh generated localhost origin follows selected WEB_PORT; custom origins are preserved.
CORS_ORIGINS=http://localhost:9000

# Docker Ops (optional - only needed for backup/restore operations)
# DOCKER_OPERATIONS_ENABLED=true
# The production Docker Agent is only reachable inside the Compose network.
